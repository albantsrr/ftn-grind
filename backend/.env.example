# PostgreSQL Database Configuration
POSTGRES_USER=fortiflow
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=fortiflow

# This is automatically constructed from the above values
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://fortiflow:your_password@postgres:5432/fortiflow

# JWT Authentication
SECRET_KEY=your_secret_key_change_in_production_use_openssl_rand_hex_32

# Email Configuration (SendGrid)
# Set USE_REAL_EMAIL=true to send real emails via SendGrid
# Get your API key from: https://app.sendgrid.com/settings/api_keys
USE_REAL_EMAIL=false
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=noreply@fortiflow.com

# Frontend URL (used for email verification links)
# Development: http://localhost:5173
# Production: your actual domain (e.g., https://fortiflow.com)
# Note: For Tauri desktop app, users will use the app to verify, so use a web URL
FRONTEND_URL=http://localhost:5173
